# Copy to .env for local use. On Render these are set in render.yaml / the dashboard — never commit real values.

# ---- core (required in production)
NODE_ENV=production
PORT=8080
# The public address of the site. For the staging site it MUST contain "staging" (that is what allows test codes and the fake payment gateway).
PUBLIC_URL=https://www.example.com
# Signs OTP hashes. Long and random: openssl rand -base64 48 . Changing it logs nobody out but invalidates codes in flight.
APP_SECRET=
DATABASE_URL=postgres://user:password@host:5432/thirupavai
REDIS_URL=redis://host:6379
# Number of server processes per container. Use 1 per CPU core of the plan (1c-2g -> 1). Add INSTANCES instead of cores where you can.
WEB_CONCURRENCY=1
# Database connections per process. instances x processes x PG_POOL_MAX must stay below the database's connection limit.
PG_POOL_MAX=10

# ---- who can open the admin console on first start (their mobile number; more staff are added inside the console)
SEED_ADMIN_MOBILE=

# ---- sign-in codes by SMS (MSG91 shown; the code is hashed, never stored in clear)
OTP_MODE=sms
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=
MSG91_SENDER=THIRPV
# abuse limits (defaults shown): sends per mobile / per IP per 10 minutes, and a daily hard stop on SMS spend
OTP_PER_MOBILE=4
OTP_PER_IP=300
OTP_DAILY_CAP=200000
API_RATE_PER_MIN=900

# ---- payments (Razorpay). Webhook URL to register in the Razorpay dashboard: https://YOUR-SITE/api/payments/webhook (events: payment.captured, order.paid)
PAYMENTS_MODE=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- shown to customers (footer, invoice, contact page)
BUSINESS_NAME=Thirupavai
GSTIN=
SUPPORT_EMAIL=
SUPPORT_PHONE=

# ---- STAGING ONLY (the server refuses these unless PUBLIC_URL contains "staging")
# OTP_MODE=demo
# ALLOW_DEMO_OTP=1
# PAYMENTS_MODE=mock
# ALLOW_MOCK_PAYMENTS=1
